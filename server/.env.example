# Copy to server/.env; keep private and outside version control.
VN_ENV=development
VN_DOMAIN=reader.example.com
BETTER_AUTH_URL=http://127.0.0.1:5173
BETTER_AUTH_SECRET=
VN_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
VN_ACCOUNT_DATABASE_PATH=data/accounts.sqlite3
VN_ACCOUNT_HOST=127.0.0.1
VN_ACCOUNT_PORT=3005
# Account login stays disabled until a secret and real SMTP delivery are configured.
VN_SMTP_HOST=
VN_SMTP_PORT=587
VN_SMTP_USERNAME=
VN_SMTP_PASSWORD=
VN_SMTP_FROM=
VN_SMTP_SSL=false
VN_ARCHIVE_ENABLED=true
VN_DATABASE_PATH=data/vn-reader.sqlite3
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_SOURCE=@Vidurneeti
TELEGRAM_DESTINATION=-1004434351194
TELEGRAM_READER_SESSION=data/telegram-reader
# Bot sessions use fresh in-memory authorization; no bot session files are shared.
# Leave blank for automatic topic creation, or 0 for the existing General topic.
TELEGRAM_ARCHIVE_TOPIC_ID=
# Production Compose: set VN_DOMAIN=vidurneeti.xyz. Compose derives the HTTPS
# Better Auth URL and allowed origin from VN_DOMAIN; data paths stay in volumes.
# Cloudflare token goes in deploy/secrets/cloudflare-tunnel-token, never here.

# Existing private Logs forum topic (required for operator notifications).
TELEGRAM_LOG_TOPIC_ID=

# Critical failures only; routine events stay in the Logs topic.
TELEGRAM_OWNER_ID=5988446905
