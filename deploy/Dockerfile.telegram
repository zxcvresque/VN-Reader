FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt && useradd -u 1000 -m reader && mkdir /data && chown reader:reader /data
COPY server/__init__.py server/app.py server/telegram.py server/streaming.py server/mirror.py server/notifications.py server/bot_sessions.py ./server/
USER reader
ENV VN_DATABASE_PATH=/data/vn-reader.sqlite3 TELEGRAM_READER_SESSION=/data/telegram-reader
CMD ["uvicorn", "server.app:app", "--host", "0.0.0.0", "--port", "8000"]
